{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist-server",
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowJs": true
  },
  "include": ["server.ts", "server/**/*.ts"],
  "exclude": ["src", "node_modules", "dist", "dist-server"]
}
